[Unit]
Description=Seaview daily tile update
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Cruise environments from settings.toml, processed in this order, and how many past days to fill in.
Environment="CRUISES=wam subsea bioreactors" DAYS=3
ExecStart=/bin/bash /opt/seaview/server/run-daily.sh
# A run normally takes minutes; the limit stays below the 12 h between scheduled runs.
TimeoutStartSec=11h
